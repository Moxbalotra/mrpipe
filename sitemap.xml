<style>
:root{--bg:#f7f9fc;--text:#17202b;--muted:#687282;--orange:#f36f21;--line:#e5e9ef}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#fff,#f7f9fc);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6}
.container{width:min(1050px,calc(100% - 30px));margin:auto}
header{padding:28px 0;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line)}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--text)}.logo img{width:58px;height:58px;object-fit:contain}
.logo strong{font-size:22px;letter-spacing:.7px}.logo span{display:block;font-size:10px;color:#7b8491;letter-spacing:1.4px}
.home{padding:10px 15px;border-radius:10px;background:var(--orange);color:#fff;text-decoration:none;font-weight:800;font-size:13px}
.hero{padding:55px 0 35px}.eyebrow{color:#e76519;font-size:12px;font-weight:900;letter-spacing:1.3px;text-transform:uppercase}
h1{font-size:clamp(38px,6vw,58px);line-height:1.05;letter-spacing:-2px;margin:10px 0}
.hero p{color:var(--muted);max-width:700px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;padding-bottom:55px}
.sitemap-card{display:flex;gap:16px;padding:21px;border:1px solid var(--line);border-radius:17px;background:#fff;text-decoration:none;color:var(--text);box-shadow:0 8px 28px rgba(20,35,55,.05);transition:.2s}
.sitemap-card:hover{transform:translateY(-3px);border-color:#ffc7aa}
.arrow{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:#fff2e9;color:var(--orange);font-weight:900;flex:none}
h2{font-size:18px;margin:0 0 3px}.sitemap-card p{font-size:13px;color:var(--muted);margin:0 0 4px}small{font-size:11px;color:#8a93a0;word-break:break-all}
footer{border-top:1px solid var(--line);padding:25px 0;color:#7b8491;text-align:center;font-size:12px}footer a{color:var(--orange);text-decoration:none}
@media(max-width:700px){.grid{grid-template-columns:1fr}header{align-items:flex-start}}
</style>
</head>
